[Desktop Entry]
Type=Application
Name=ENGLAT PDF
GenericName=PDF Editor
Comment=Read, organize, combine, split and secure PDFs
Exec=englat-pdf %U
TryExec=englat-pdf
Icon=com.englat.pdf
Terminal=false
